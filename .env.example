# ===================================================================
# Student Internship Tracker - Environment Variables Template
# Copy this file to .env or set these environment variables in your OS/shell.
# ===================================================================

# Database Connection URL (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/internship_tracker?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Username
SPRING_DATASOURCE_USERNAME=root

# MySQL Database Password
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Server Port (default 8080)
SERVER_PORT=8080
