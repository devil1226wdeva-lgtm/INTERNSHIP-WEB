# ===================================================================
# Student Internship Tracker - Environment Variables Template
# Copy this file to .env or set these environment variables in your OS/shell.
# ===================================================================

# Database Connection URL (Supabase PostgreSQL Session Pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require&sslfactory=org.postgresql.ssl.NonValidatingFactory

# PostgreSQL Username
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF

# PostgreSQL Password
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# Server Port (default 8080)
SERVER_PORT=8080

# Supabase Platform Details
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
